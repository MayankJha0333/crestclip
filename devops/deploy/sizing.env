# How much runs on the server at once. Change a number, commit, push — the server applies it on the next deploy.
# Sized for e2-standard-4 (4 CPUs, 16 GB). A clip encode uses about 1 CPU, so keep WORKERS × WORKER_RENDERS ≈ CPUs.

# worker containers taking video jobs (more = more videos at once, if the CPUs allow)
WORKERS=2
# videos each worker works on at once. Most of a video's time is waiting (YouTube download, AI answers), so a
# worker can juggle several; the CPU-heavy part is capped separately by WORKER_RENDERS below.
# 2 workers × 5 = 10 videos in progress. Lower it if /admin/ shows CPU stuck near 100% or memory running out.
WORKER_JOBS=5
# clip encodes each worker runs at once (the CPU-heavy part)
WORKER_RENDERS=2
