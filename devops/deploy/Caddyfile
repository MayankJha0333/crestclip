# Caddy: free HTTPS for the domain (Let's Encrypt, renewed by itself) + the load balancer in front of the app.
# The domain must point at this server (DNS A record).

{$DOMAIN} {
	encode zstd gzip

	# ---- admin pages: only for people signed in to CrestClip as an admin ----
	# The app answers /admin/gate: 204 = admin, 401 = anyone else (shown a "sign in" note).
	handle /admin/gate {
		reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
			lb_try_duration 5s
		}
	}
	handle /admin* {
		forward_auth 127.0.0.1:8787 127.0.0.1:8788 {
			uri /admin/gate
			lb_try_duration 5s
		}
		# live logs of every container (Dozzle)
		handle /admin/logs* {
			reverse_proxy 127.0.0.1:8081
		}
		# overview, jobs, costs (devops/dashboard)
		handle {
			reverse_proxy 127.0.0.1:8790
		}
	}

	# ---- the app: two copies, load-balanced ----
	handle {
		reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
			# each browser sticks to one copy (a cookie), so caches stay warm; a copy that's down is skipped
			lb_policy cookie cc_lb
			# a copy restarting during a deploy: retry the other one instead of showing an error
			lb_try_duration 20s
			lb_try_interval 250ms
			fail_duration 10s
			health_uri /api/live
			health_interval 5s
			health_timeout 3s
			# pass progress updates and long downloads through straight away
			flush_interval -1
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
