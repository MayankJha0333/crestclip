# ─────────────────────────────────────────────────────────────
# CrestClip settings — copy this file to .env and fill it in
# ─────────────────────────────────────────────────────────────

# ── Credentials: pick ONE ──
# A) Vertex AI API key bound to a service account (easiest, no gcloud needed on this computer)
VERTEX_API_KEY=
# B) Project + `gcloud auth application-default login` (also enables Cloud Storage uploads)
# Google Cloud project that has your credits (Vertex AI / Gemini)
GOOGLE_CLOUD_PROJECT=your-project-id
# "global" is what Google recommends for the Gemini 3.x models
GOOGLE_CLOUD_LOCATION=global
# Optional: service-account key file (instead of `gcloud auth application-default login`). Relative to this folder.
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini models (Vertex model IDs). Main = finding viral moments. Fast = transcription + face finding.
# gemini-2.5-* models retire on Vertex on Oct 20, 2026 — don't use them.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# A Cloud Storage bucket (same Google login as Gemini). Recommended. With it:
#  · every rendered clip is also kept in the bucket (under crestclip/media/), so clips survive a lost or new disk
#  · Gemini can also WATCH uploaded files, not just listen (YouTube links get video analysis without a bucket)
#  · CrestClip adds one rule to the bucket: files under crestclip/ are deleted a day after RETENTION_DAYS (safety net)
GCS_BUCKET=
# Keep clips in the bucket (true) or only on this disk (false)
CLOUD_CLIPS=true
# Projects — video, clips and files, here and in the bucket — are deleted this many days after they're made
RETENTION_DAYS=7

# Send the video itself to Gemini (true) or only transcript + signals (false, cheaper)
GEMINI_SEND_VIDEO=true

# Database (MongoDB) — e.g. a free MongoDB Atlas cluster: Connect → Drivers → copy the connection string.
# Allow this computer's / server's IP in Atlas → Network Access.
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB=crestclip
# Optional: if MONGODB_URI has no user in it, these are added to it
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# Server
PORT=8787
# Video files, clips and tools (the database itself is in MongoDB)
DATA_DIR=data
MAX_SOURCE_MINUTES=240
MAX_UPLOAD_MB=4096
JOB_CONCURRENCY=1
RENDER_CONCURRENCY=2
# ultrafast | veryfast | medium (better quality, slower)
X264_PRESET=medium

# Background music: instrumental tracks made with Google's Lyria model on Vertex AI (same project/credits as Gemini).
# Each mood is generated once and reused. Users can also upload their own tracks.
MUSIC_MODEL=lyria-002
MUSIC_LOCATION=us-central1

# Long links (8+ min): download only the audio + the parts that become clips, not the whole video.
# Saves ~90%+ of the download. Set DOWNLOAD_MODE=full to always download the whole video.
DOWNLOAD_MODE=smart
# Seconds kept around each clip part, so small trims in the editor don't need another download.
SECTION_PAD_SECONDS=20

# yt-dlp (links + YouTube "Most replayed" data) is installed and kept up to date by CrestClip automatically.
# Only set YTDLP_PATH to force your own copy. YTDLP_CHANNEL=nightly gets YouTube fixes sooner.
YTDLP_PATH=
YTDLP_CHANNEL=stable
# yt-dlp needs a JavaScript runtime for YouTube. Node works; use "" if you installed deno.
YTDLP_EXTRA_ARGS=--js-runtimes node
# Optional cookies.txt for age-restricted videos or "confirm you're not a bot" errors (use a spare account)
YTDLP_COOKIES=

# Optional: Twitch API app from https://dev.twitch.tv/console (free) — enables Twitch channel search in Explore.
# Without it, Explore finds Twitch channels by exact name.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ffmpeg ships inside CrestClip (with caption support). Only set these to force your own build.
FFMPEG_PATH=
FFPROBE_PATH=

# Development only: fake Gemini answers so you can click around without a Google Cloud project
CRESTCLIP_FAKE_AI=0

# ---------- Posting to YouTube & Instagram (optional) ----------
# Where people open CrestClip. OAuth sends them back here after they sign in.
# Dev: http://localhost:5173 · Production: https://your-domain.com (Instagram REQUIRES https — use a tunnel like ngrok while testing)
PUBLIC_URL=http://localhost:5173
# YouTube: Google Cloud → enable "YouTube Data API v3" → OAuth client (Web application)
#   redirect URI: <PUBLIC_URL>/api/connect/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Instagram: Meta for Developers → app → Instagram → "API setup with Instagram login"
#   redirect URL (local dev): https://localhost:8443/api/connect/instagram/callback
#   redirect URL (live site):  <PUBLIC_URL>/api/connect/instagram/callback
#   Instagram needs https, so in dev CrestClip also serves https://localhost:8443 (self-made certificate).
#   Use the INSTAGRAM APP ID/SECRET from Instagram → API setup with Instagram login (not the Facebook App ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# HTTPS_PORT=8443
# Account tokens are stored encrypted. Leave empty to use an auto-generated key in data/secret.key
SECRET_KEY=

# ---------- Autopilot (daily automatic clipping + posting) ----------
# Autopilot times its jobs with Redis. Leave REDIS_URL empty and CrestClip uses a Redis already running on this
# computer (127.0.0.1:6379), or sets up its own private copy (Valkey, built once — needs Apple's command line tools).
# In production, point it at a hosted Redis, e.g. REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379
# REDIS_URL=off turns Autopilot off.
REDIS_URL=

# ---------- Accounts ----------
# The first account created becomes the admin (on Pro, free). More admins (comma-separated):
ADMIN_EMAILS=
# false = only existing accounts can log in (the first account can always be created)
ALLOW_SIGNUPS=true
# "Continue with Google": leave empty to reuse YOUTUBE_CLIENT_ID/SECRET (add <PUBLIC_URL>/api/auth/google/callback
# as an extra redirect URI on that OAuth client), or use a separate OAuth client here.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# ---------- Your business (shown on About, Contact, Terms, Privacy, Refunds, Shipping pages) ----------
# Razorpay checks that these match your Razorpay account before allowing live payments.
BUSINESS_NAME=CrestClip
# Your legal name (sole proprietor) or registered company name
BUSINESS_LEGAL_NAME=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Full postal address (one line)
BUSINESS_ADDRESS=
# City and state whose courts handle disputes, e.g. Bengaluru, Karnataka
BUSINESS_JURISDICTION=
# When people can reach you (shown on Contact and policy pages)
SUPPORT_HOURS=Monday to Friday, 10 am – 6 pm IST
# Person who handles complaints (defaults to BUSINESS_LEGAL_NAME)
GRIEVANCE_OFFICER=

# ---------- Plans, credits & payments (Razorpay) ----------
# Dashboard → Account & Settings → API Keys (use Test Mode keys until you go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# CrestClip charges in US dollars only: Creator $15/month, Pro $29/month, top-up $5 (plans.ts).
# Needs Razorpay "International Payments" (Payment Methods → International Payments → Request; up to 5 working days).
# Dashboard → Subscriptions → Plans: a MONTHLY plan in USD for each — Creator $15, Pro $29. CrestClip checks each plan
# and refuses to start a checkout if its currency, amount or period doesn't match.
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_PRO=
# Dashboard → Webhooks → <PUBLIC_URL>/api/billing/webhook, with a secret you choose, events:
#   subscription.activated, subscription.charged, subscription.cancelled, subscription.halted, subscription.completed, payment.captured
RAZORPAY_WEBHOOK_SECRET=
